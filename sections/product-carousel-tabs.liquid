{% liquid
  assign section_id = section.id
  assign color_scheme = section.settings.color_scheme
  assign heading = section.settings.heading
  assign subheading_text = section.settings.subheading_text
  assign max_products = section.settings.max_products | default: 5
  assign section_width = section.settings.section_width
%}

<div class="section-background color-{{ color_scheme }}"></div>
<product-carousel-tabs
  class="section spacing-style color-{{ color_scheme }} product-carousel-tabs"
  id="ProductCarouselTabs-{{ section_id }}"
  style="
    {%- render 'spacing-style', settings: section.settings -%};
    overflow: hidden;
  "
>
  <div class="product-carousel-tabs__inner {% if section_width == 'page-width' %}page-width{% else %}full-width{% endif %}">
    {%- comment -%} Header area {%- endcomment -%}
    <div class="product-carousel-tabs__header">
      <div class="product-carousel-tabs__title-area">
        {%- if subheading_text != blank -%}
          <div class="product-carousel-tabs__brought">
            <span class="product-carousel-tabs__brought-text">{{ subheading_text }}</span>
            <img
              class="product-carousel-tabs__logo product-carousel-tabs__logo--desktop"
              src="{{ 'logo-factor-2.svg' | asset_url }}"
              alt="Factor"
              width="130"
              height="18"
              loading="lazy"
            >
            <img
              class="product-carousel-tabs__logo product-carousel-tabs__logo--mobile"
              src="{{ 'logo-factor.svg' | asset_url }}"
              alt="Factor"
              width="87"
              height="12"
              loading="lazy"
            >
          </div>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="product-carousel-tabs__heading">{{ heading }}</h2>
        {%- endif -%}
      </div>

      <div class="product-carousel-tabs__controls">
        {%- comment -%} Tab navigation {%- endcomment -%}
        <div class="product-carousel-tabs__tabs" ref="tabs">
          <div class="product-carousel-tabs__tabs-inner">
            {%- for block in section.blocks -%}
              {%- assign tab_label = block.settings.tab_label | default: block.settings.collection.title -%}
              {%- if tab_label == blank -%}
                {%- assign tab_label = 'Collection ' | append: forloop.index -%}
              {%- endif -%}
              <button
                class="product-carousel-tabs__tab{% if forloop.first %} product-carousel-tabs__tab--active{% endif %}"
                ref="tabButtons[]"
                on:click="/handleTabClick"
                data-tab-index="{{ forloop.index0 }}"
                type="button"
                {{ block.shopify_attributes }}
              >
                {{ tab_label }}
              </button>
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} Arrows (desktop only) {%- endcomment -%}
        <div class="product-carousel-tabs__arrows" ref="arrows">
          <button
            class="product-carousel-tabs__arrow product-carousel-tabs__arrow--prev"
            ref="prevArrow"
            on:click="/handlePrevClick"
            type="button"
            aria-label="{{ 'accessibility.slideshow_previous' | t }}"
          >
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M23 14L17 20L23 26" stroke="#9B9B86" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <button
            class="product-carousel-tabs__arrow product-carousel-tabs__arrow--next"
            ref="nextArrow"
            on:click="/handleNextClick"
            type="button"
            aria-label="{{ 'accessibility.slideshow_next' | t }}"
          >
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M17 14L23 20L17 26" stroke="#141414" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    {%- comment -%} Tab content panels {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- assign tab_label = block.settings.tab_label | default: block.settings.collection.title -%}
      {%- if tab_label == blank -%}
        {%- assign tab_label = 'Collection ' | append: forloop.index -%}
      {%- endif -%}
      <div
        class="product-carousel-tabs__panel{% if forloop.first %} product-carousel-tabs__panel--active{% endif %}"
        ref="tabPanels[]"
        data-tab-index="{{ forloop.index0 }}"
      >
        <div class="product-carousel-tabs__carousel" ref="carousels[]">
          {%- comment -%} Category overlay card {%- endcomment -%}
          <div class="product-carousel-tabs__category-card">
            {%- if block.settings.category_image != blank -%}
              <div class="product-carousel-tabs__category-image">
                {%- assign cat_sizes = '(min-width: 750px) 328px, 160px' -%}
                {{
                  block.settings.category_image
                  | image_url: width: block.settings.category_image.width
                  | image_tag:
                    sizes: cat_sizes,
                    widths: '160,320,328,502,656',
                    loading: 'lazy',
                    alt: tab_label,
                    class: 'product-carousel-tabs__category-img'
                }}
              </div>
            {%- else -%}
              <div class="product-carousel-tabs__category-image product-carousel-tabs__category-image--placeholder">
                {{ 'collection-1' | placeholder_svg_tag: 'product-carousel-tabs__category-placeholder' }}
              </div>
            {%- endif -%}
            <div class="product-carousel-tabs__category-overlay"></div>
            <div class="product-carousel-tabs__category-content">
              <h3 class="product-carousel-tabs__category-title">{{ tab_label }}</h3>
              {%- if block.settings.category_description != blank -%}
                <p class="product-carousel-tabs__category-desc">{{ block.settings.category_description }}</p>
              {%- endif -%}
              {%- assign cta_text = block.settings.category_cta_text | default: 'VIEW ALL' -%}
              {%- if block.settings.category_link != blank -%}
                <a href="{{ block.settings.category_link }}" class="product-carousel-tabs__category-cta">{{ cta_text }}</a>
              {%- else -%}
                {%- if block.settings.collection != blank -%}
                  <a href="{{ block.settings.collection.url }}" class="product-carousel-tabs__category-cta">{{ cta_text }}</a>
                {%- else -%}
                  <span class="product-carousel-tabs__category-cta">{{ cta_text }}</span>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>

          {%- comment -%} Product cards from collection {%- endcomment -%}
          {%- if block.settings.collection != blank -%}
            {%- for product in block.settings.collection.products limit: max_products -%}
              <div class="product-carousel-tabs__product-card">
                <div class="product-carousel-tabs__product-image-wrap">
                  <a href="{{ product.url }}" class="product-carousel-tabs__product-link" aria-label="{{ product.title }}">
                    {%- if product.featured_image != blank -%}
                      {%- assign prod_sizes = '(min-width: 750px) 328px, 160px' -%}
                      {{
                        product.featured_image
                        | image_url: width: product.featured_image.width
                        | image_tag:
                          sizes: prod_sizes,
                          widths: '160,320,328,656',
                          loading: 'lazy',
                          alt: product.title,
                          class: 'product-carousel-tabs__product-img'
                      }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'product-carousel-tabs__product-placeholder' }}
                    {%- endif -%}
                  </a>

                  {%- comment -%} Badges {%- endcomment -%}
                  <div class="product-carousel-tabs__badges">
                    {%- for tag in product.tags -%}
                      {%- if tag contains 'badge:' -%}
                        {%- assign badge_text = tag | remove: 'badge:' | strip -%}
                        {%- assign badge_lower = badge_text | downcase -%}
                        {%- assign is_sale_badge = false -%}
                        {%- if badge_lower contains 'off' or badge_lower contains 'sale' -%}
                          {%- assign is_sale_badge = true -%}
                        {%- endif -%}
                        <span class="product-carousel-tabs__badge{% if is_sale_badge %} product-carousel-tabs__badge--sale{% endif %}">
                          {{ badge_text }}
                        </span>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if product.compare_at_price > product.price -%}
                      {%- assign save_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                      {%- assign has_sale_tag = false -%}
                      {%- for tag in product.tags -%}
                        {%- if tag contains 'badge:' -%}
                          {%- assign badge_lower = tag | downcase -%}
                          {%- if badge_lower contains 'off' or badge_lower contains 'sale' -%}
                            {%- assign has_sale_tag = true -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- unless has_sale_tag -%}
                        <span class="product-carousel-tabs__badge product-carousel-tabs__badge--sale">
                          {{ save_percent }}% OFF
                        </span>
                      {%- endunless -%}
                    {%- endif -%}
                  </div>
                </div>

                {%- comment -%} Progress bar {%- endcomment -%}
                <div class="product-carousel-tabs__progress-bar">
                  <div class="product-carousel-tabs__progress-bar-track"></div>
                  <div class="product-carousel-tabs__progress-bar-fill"></div>
                </div>

                {%- comment -%} Content area {%- endcomment -%}
                <div class="product-carousel-tabs__product-content">
                  <div class="product-carousel-tabs__product-info">
                    <a href="{{ product.url }}" class="product-carousel-tabs__product-title-link">
                      <h4 class="product-carousel-tabs__product-title">{{ product.title }}</h4>
                    </a>
                    {%- if product.description != blank -%}
                      <p class="product-carousel-tabs__product-desc">{{ product.description | strip_html | truncate: 80 }}</p>
                    {%- endif -%}
                  </div>
                  <div class="product-carousel-tabs__product-bottom">
                    <div class="product-carousel-tabs__product-pricing">
                      <span class="product-carousel-tabs__product-price">{{ product.price | money }}</span>
                      {%- if product.compare_at_price > product.price -%}
                        <span class="product-carousel-tabs__product-compare-price">{{ product.compare_at_price | money }}</span>
                      {%- endif -%}
                    </div>
                    <a
                      href="{{ product.url }}"
                      class="product-carousel-tabs__add-to-cart"
                    >
                      {{ 'products.product.add_to_cart' | t }}
                    </a>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Placeholder cards when no collection is assigned {%- endcomment -%}
            {%- for i in (1..3) -%}
              <div class="product-carousel-tabs__product-card">
                <div class="product-carousel-tabs__product-image-wrap">
                  {{ 'product-1' | placeholder_svg_tag: 'product-carousel-tabs__product-placeholder' }}
                  <div class="product-carousel-tabs__badges"></div>
                </div>
                <div class="product-carousel-tabs__progress-bar">
                  <div class="product-carousel-tabs__progress-bar-track"></div>
                  <div class="product-carousel-tabs__progress-bar-fill"></div>
                </div>
                <div class="product-carousel-tabs__product-content">
                  <div class="product-carousel-tabs__product-info">
                    <h4 class="product-carousel-tabs__product-title">{{ 'placeholders.product_title' | t }}</h4>
                    <p class="product-carousel-tabs__product-desc">{{ 'content.product_card_placeholder' | t }}</p>
                  </div>
                  <div class="product-carousel-tabs__product-bottom">
                    <div class="product-carousel-tabs__product-pricing">
                      <span class="product-carousel-tabs__product-price">$0.00</span>
                    </div>
                    <span class="product-carousel-tabs__add-to-cart">{{ 'products.product.add_to_cart' | t }}</span>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</product-carousel-tabs>

{% stylesheet %}
  .product-carousel-tabs {
    display: block;
    overflow: hidden;
  }

  .product-carousel-tabs__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .product-carousel-tabs__header {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-inline: 16px;
  }

  .product-carousel-tabs__title-area {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .product-carousel-tabs__brought {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .product-carousel-tabs__brought-text {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 14px;
    color: #2A523F;
  }

  .product-carousel-tabs__logo--desktop {
    display: none;
  }

  .product-carousel-tabs__logo--mobile {
    display: block;
  }

  .product-carousel-tabs__heading {
    font-family: var(--font-heading--family);
    font-weight: 300;
    font-size: 32px;
    line-height: 40px;
    color: #141414;
    margin: 0;
    letter-spacing: 0;
  }

  .product-carousel-tabs__controls {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .product-carousel-tabs__tabs {
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .product-carousel-tabs__tabs::-webkit-scrollbar {
    display: none;
  }

  .product-carousel-tabs__tabs-inner {
    display: flex;
    gap: 24px;
    align-items: center;
    padding-inline-end: 32px;
  }

  .product-carousel-tabs__tab {
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    padding: 0 0 4px 0;
    cursor: pointer;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 18px;
    line-height: 28px;
    color: #656558;
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .product-carousel-tabs__tab--active {
    color: #141414;
    border-bottom-color: #141414;
  }

  .product-carousel-tabs__tab:hover {
    color: #141414;
  }

  .product-carousel-tabs__arrows {
    display: none;
  }

  .product-carousel-tabs__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .product-carousel-tabs__arrow svg {
    width: 40px;
    height: 40px;
  }

  /* Panels */
  .product-carousel-tabs__panel {
    display: none;
  }

  .product-carousel-tabs__panel--active {
    display: block;
  }

  /* Carousel */
  .product-carousel-tabs__carousel {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-inline: 16px;
  }

  .product-carousel-tabs__carousel::-webkit-scrollbar {
    display: none;
  }

  /* Category card */
  .product-carousel-tabs__category-card {
    position: relative;
    flex: 0 0 160px;
    height: 334px;
    overflow: hidden;
    scroll-snap-align: start;
  }

  .product-carousel-tabs__category-image {
    position: absolute;
    inset: 0;
  }

  .product-carousel-tabs__category-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-carousel-tabs__category-image--placeholder {
    background: #8b8b7a;
  }

  .product-carousel-tabs__category-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-carousel-tabs__category-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 20, 20, 0) 0%, rgba(20, 20, 20, 1) 100%);
    pointer-events: none;
  }

  .product-carousel-tabs__category-content {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 1;
  }

  .product-carousel-tabs__category-title {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 20px;
    line-height: 28px;
    color: #ffffff;
    margin: 0;
  }

  .product-carousel-tabs__category-desc {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: #ffffff;
    margin: 0;
  }

  .product-carousel-tabs__category-cta {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 12px;
    line-height: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Product card */
  .product-carousel-tabs__product-card {
    flex: 0 0 160px;
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
  }

  .product-carousel-tabs__product-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .product-carousel-tabs__product-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-carousel-tabs__product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-carousel-tabs__product-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #e0e0d8;
  }

  /* Badges */
  .product-carousel-tabs__badges {
    position: absolute;
    inset-block-start: 8px;
    inset-inline-start: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 1;
  }

  .product-carousel-tabs__badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 6px;
    background: #141414;
    color: #ffffff;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 10px;
    line-height: 12px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .product-carousel-tabs__badge--sale {
    background: #EC0606;
  }

  /* Progress bar */
  .product-carousel-tabs__progress-bar {
    position: relative;
    height: 2px;
    width: 100%;
  }

  .product-carousel-tabs__progress-bar-track {
    position: absolute;
    inset: 0;
    background: #ffffff;
  }

  .product-carousel-tabs__progress-bar-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 46px;
    background: #6FAB84;
  }

  /* Product content */
  .product-carousel-tabs__product-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: space-between;
    padding: 8px;
    background: #ffffff;
    flex: 1;
  }

  .product-carousel-tabs__product-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .product-carousel-tabs__product-title-link {
    text-decoration: none;
    color: inherit;
  }

  .product-carousel-tabs__product-title {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    color: #141414;
    margin: 0;
  }

  .product-carousel-tabs__product-desc {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
    color: #141414;
    margin: 0;
  }

  .product-carousel-tabs__product-bottom {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .product-carousel-tabs__product-pricing {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .product-carousel-tabs__product-price {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    color: #141414;
  }

  .product-carousel-tabs__product-compare-price {
    font-family: var(--font-heading--family);
    font-weight: 300;
    font-size: 12px;
    line-height: 16px;
    color: #141414;
    text-decoration: line-through;
  }

  .product-carousel-tabs__add-to-cart {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 4px 8px;
    background: #141414;
    color: #ffffff;
    border: none;
    border-radius: 24px;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 12px;
    line-height: 16px;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .product-carousel-tabs__add-to-cart:hover {
    background: #2A523F;
  }

  /* ============================
     Desktop (min-width: 750px)
     ============================ */
  @media screen and (min-width: 750px) {
    .product-carousel-tabs__inner {
      gap: 32px;
    }

    .product-carousel-tabs__header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 32px;
      padding-inline: 64px;
    }

    .product-carousel-tabs__title-area {
      gap: 24px;
    }

    .product-carousel-tabs__brought {
      gap: 8px;
    }

    .product-carousel-tabs__brought-text {
      font-size: 18px;
      line-height: 18px;
    }

    .product-carousel-tabs__logo--desktop {
      display: block;
    }

    .product-carousel-tabs__logo--mobile {
      display: none;
    }

    .product-carousel-tabs__heading {
      font-size: 48px;
      line-height: 56px;
    }

    .product-carousel-tabs__controls {
      flex-direction: row;
      align-items: flex-end;
      gap: 48px;
    }

    .product-carousel-tabs__tabs-inner {
      gap: 40px;
      padding-inline-end: 0;
    }

    .product-carousel-tabs__tab {
      font-size: 24px;
      line-height: 24px;
      padding: 0 0 8px 0;
    }

    .product-carousel-tabs__arrows {
      display: flex;
      gap: 16px;
      align-items: center;
    }

    .product-carousel-tabs__carousel {
      gap: 32px;
      padding-inline: 64px;
    }

    /* Category card desktop */
    .product-carousel-tabs__category-card {
      flex: 0 0 328px;
      height: 502px;
    }

    .product-carousel-tabs__category-content {
      padding: 16px;
      gap: 4px;
    }

    .product-carousel-tabs__category-title {
      font-size: 20px;
      line-height: 28px;
    }

    .product-carousel-tabs__category-desc {
      font-size: 16px;
      line-height: 24px;
      margin-block-end: 20px;
    }

    .product-carousel-tabs__category-cta {
      font-size: 14px;
      line-height: 14px;
      letter-spacing: 1.4px;
    }

    /* Product card desktop */
    .product-carousel-tabs__product-card {
      flex: 0 0 328px;
    }

    .product-carousel-tabs__badges {
      inset-block-start: 12px;
      inset-inline-start: 12px;
    }

    .product-carousel-tabs__badge {
      padding: 6px 12px;
      font-size: 12px;
      line-height: 12px;
      letter-spacing: 0.6px;
    }

    .product-carousel-tabs__product-content {

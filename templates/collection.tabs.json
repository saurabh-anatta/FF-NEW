        "color_scheme": "scheme-5",
        "padding-block-start": 24,
        "padding-block-end": 24
      },
      "blocks": {
        "tab-all": {
          "type": "tab",
          "settings": {
            "tab_label": "All Products",
            "target_section_id": "all-products"
          }
        },

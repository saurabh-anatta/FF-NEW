{% doc %}
  PDP Custom image-card variant picker block.
  Renders variant options as card-style buttons with images.

  @example {% content_for 'block', type: '_pdp-variant-picker', id: 'variant-picker' %}
{% enddoc %}

{%- liquid
  assign product_resource = closest.product
  assign show_images = block.settings.show_images
  assign show_price_per_unit = block.settings.show_price_per_unit
  assign option_index = block.settings.option_index | default: 0
  assign selected_variant = product_resource.selected_or_first_available_variant
-%}

<pdp-variant-picker {{ block.shopify_attributes }}>
  {%- for option in product_resource.options_with_values -%}
    <div class="pdp-variant-picker__option">
      <div class="pdp-variant-picker__label">
        <span class="pdp-variant-picker__label-text">Select {{ option.name }}:</span>
        <span class="pdp-variant-picker__label-value" data-selected-value="{{ option.position }}">
          {{- selected_variant.options[forloop.index0] -}}
        </span>
      </div>

      <div class="pdp-variant-picker__cards">
        {%- for value in option.values -%}
          {%- liquid
            assign is_selected = false
            if selected_variant.options[forloop.parentloop.index0] == value
              assign is_selected = true
            endif

            assign variant_for_value = nil
            for v in product_resource.variants
              if v.options[forloop.parentloop.parentloop.index0] == value
                unless variant_for_value
                  assign variant_for_value = v
                endunless
              endif
            endfor
          -%}

          <button
            type="button"
            class="pdp-variant-picker__card{% if is_selected %} is-selected{% endif %}"
            data-option-card
            data-option-position="{{ option.position }}"
            data-option-value="{{ value }}"
            aria-checked="{{ is_selected }}"
            role="radio"
            aria-label="{{ option.name }}: {{ value }}"
            on:click="/handleOptionSelect"
          >
            {%- if show_images and variant_for_value.featured_image -%}
              <div class="pdp-variant-picker__card-image">
                <img
                  src="{{ variant_for_value.featured_image | image_url: width: 128 }}"
                  alt="{{ value }}"
                  width="64"
                  height="64"
                  loading="lazy"
                >
              </div>
            {%- endif -%}

            <div class="pdp-variant-picker__card-text">
              <span class="pdp-variant-picker__card-name">{{ value }}</span>
              {%- if show_price_per_unit and variant_for_value -%}
                <span class="pdp-variant-picker__card-sublabel">
                  {{ variant_for_value.price | money }}
                </span>
              {%- endif -%}
            </div>
          </button>
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}

  <script type="application/json" data-variant-json>
    [
      {%- for variant in product_resource.variants -%}
        {
          "id": {{ variant.id }},
          "title": {{ variant.title | json }},
          "available": {{ variant.available }},
          "price": {{ variant.price }},
          "compare_at_price": {{ variant.compare_at_price | default: 'null' }},
          "options": {{ variant.options | json }},
          "featured_image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 128 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  <script type="module" src="{{ 'pdp-variant-picker.js' | asset_url }}" defer></script>
</pdp-variant-picker>

{% stylesheet %}
.pdp-variant-picker__option {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.pdp-variant-picker__option + .pdp-variant-picker__option {
  margin-block-start: 24px;
}

.pdp-variant-picker__label {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4px;
}

.pdp-variant-picker__label-text {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 14px;
  line-height: 20px;
  color: var(--color-foreground);
}

.pdp-variant-picker__label-value {
  font-family: var(--font-body--family);
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  color: var(--color-foreground);
}

.pdp-variant-picker__cards {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.pdp-variant-picker__card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border: 1px solid #D0D0BC;
  background: transparent;
  cursor: pointer;
  width: 100%;
  text-align: start;
  transition: border-color 0.15s ease;
}

.pdp-variant-picker__card:hover {
  border-color: #141414;
}

.pdp-variant-picker__card.is-selected {
  border-color: #141414;
}

.pdp-variant-picker__card.is-unavailable {
  opacity: 0.5;
  cursor: not-allowed;
}

.pdp-variant-picker__card-image {
  width: 64px;
  height: 64px;
  flex-shrink: 0;
  border: 1px solid #D0D0BC;
  overflow: hidden;
}

.pdp-variant-picker__card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.pdp-variant-picker__card-text {
  display: flex;
  flex-direction: column;
  gap: 4px;
  justify-content: center;
}

.pdp-variant-picker__card-name {
  font-family: var(--font-body--family);
  font-weight: 600;
  font-size: 14px;
  line-height: 20px;
  color: var(--color-foreground);
}

.pdp-variant-picker__card-sublabel {
  font-family: var(--font-body--family);
  font-weight: 400;
  font-size: 12px;
  line-height: 16px;
  color: var(--color-foreground);
}

@media screen and (min-width: 750px) {
  .pdp-variant-picker__cards {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .pdp-variant-picker__card {
    flex: 1 1 calc(50% - 6px);
    min-width: 0;
  }
}

@media screen and (max-width: 749px) {
  .pdp-variant-picker__card-image {
    width: 48px;
    height: 48px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.pdp_variant_picker",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "t:settings.show_images",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price_per_unit",
      "label": "t:settings.show_price_per_unit",
      "default": true
    },
    {
      "type": "number",
      "id": "option_index",
      "label": "t:settings.option_index",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.pdp_variant_picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}

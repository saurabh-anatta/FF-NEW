{%- liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign layout = section.settings.layout | default: 'grid'
  assign max_products = section.settings.max_products | default: 8
  assign show_feature_card = section.settings.show_feature_card
  assign feature_image = section.settings.feature_image
  assign feature_title = section.settings.feature_title
  assign feature_description = section.settings.feature_description
  assign feature_cta_text = section.settings.feature_cta_text
  assign feature_cta_link = section.settings.feature_cta_link
  assign feature_card_position = section.settings.feature_card_position | default: 4
  assign color_scheme = section.settings.color_scheme
  assign section_width = section.settings.section_width
-%}

<div
  class="section spacing-style color-{{ color_scheme }} plp-collection"
  style="{%- render 'spacing-style', settings: section.settings -%}"
>
  <div class="plp-collection__inner {% if section_width == 'page-width' %}page-width{% else %}full-width{% endif %}">
    {%- if heading != blank or description != blank -%}
      <div class="plp-collection__header">
        {%- if heading != blank -%}
          <h2 class="plp-collection__heading">{{ heading | escape }}</h2>
        {%- endif -%}
        {%- if description != blank -%}
          <p class="plp-collection__description">{{ description | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="plp-collection__products plp-collection__products--{{ layout }}">
      {%- if collection != blank -%}
        {%- assign grid_pos = 0 -%}
        {%- for product in collection.products limit: max_products -%}
          {%- assign grid_pos = grid_pos | plus: 1 -%}

          {%- if show_feature_card and layout == 'grid' and grid_pos == feature_card_position -%}
            <div class="plp-collection__feature-card">
              {%- if feature_image != blank -%}
                {%- assign feat_sizes = '(min-width: 750px) 328px, 50vw' -%}
                {{
                  feature_image
                  | image_url: width: feature_image.width
                  | image_tag:
                    sizes: feat_sizes,
                    widths: '160,320,328,502,656',
                    loading: 'lazy',
                    alt: feature_title,
                    class: 'plp-collection__feature-img'
                }}
              {%- endif -%}
              <div class="plp-collection__feature-overlay"></div>
              <div class="plp-collection__feature-content">
                <div class="plp-collection__feature-text">
                  {%- if feature_title != blank -%}
                    <h3 class="plp-collection__feature-title">{{ feature_title | escape }}</h3>
                  {%- endif -%}
                  {%- if feature_description != blank -%}
                    <p class="plp-collection__feature-desc">{{ feature_description | escape }}</p>
                  {%- endif -%}
                </div>
                {%- if feature_cta_text != blank -%}
                  {%- if feature_cta_link != blank -%}
                    <a href="{{ feature_cta_link }}" class="plp-collection__feature-cta">{{ feature_cta_text | escape }}</a>
                  {%- else -%}
                    <span class="plp-collection__feature-cta">{{ feature_cta_text | escape }}</span>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
            {%- assign grid_pos = grid_pos | plus: 1 -%}
          {%- endif -%}

          {%- render 'plp-product-card', product: product -%}
        {%- endfor -%}

        {%- comment -%} Render feature card at end if position exceeds product count {%- endcomment -%}
        {%- if show_feature_card and layout == 'grid' and grid_pos < feature_card_position -%}
          <div class="plp-collection__feature-card">
            {%- if feature_image != blank -%}
              {%- assign feat_sizes = '(min-width: 750px) 328px, 50vw' -%}
              {{
                feature_image
                | image_url: width: feature_image.width
                | image_tag:
                  sizes: feat_sizes,
                  widths: '160,320,328,502,656',
                  loading: 'lazy',
                  alt: feature_title,
                  class: 'plp-collection__feature-img'
              }}
            {%- endif -%}
            <div class="plp-collection__feature-overlay"></div>
            <div class="plp-collection__feature-content">
              <div class="plp-collection__feature-text">
                {%- if feature_title != blank -%}
                  <h3 class="plp-collection__feature-title">{{ feature_title | escape }}</h3>
                {%- endif -%}
                {%- if feature_description != blank -%}
                  <p class="plp-collection__feature-desc">{{ feature_description | escape }}</p>
                {%- endif -%}
              </div>
              {%- if feature_cta_text != blank -%}
                {%- if feature_cta_link != blank -%}
                  <a href="{{ feature_cta_link }}" class="plp-collection__feature-cta">{{ feature_cta_text | escape }}</a>
                {%- else -%}
                  <span class="plp-collection__feature-cta">{{ feature_cta_text | escape }}</span>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- else -%}
        {%- comment -%} Placeholder cards when no collection is assigned {%- endcomment -%}
        {%- for i in (1..4) -%}
          <div class="plp-card">
            <div class="plp-card__image-wrap">
              {{ 'product-1' | placeholder_svg_tag: 'plp-card__placeholder' }}
              <div class="plp-card__badges"></div>
            </div>
            <div class="plp-card__progress">
              <div class="plp-card__progress-track"></div>
              <div class="plp-card__progress-fill"></div>
            </div>
            <div class="plp-card__content">
              <div class="plp-card__info">
                <h4 class="plp-card__title">{{ 'placeholders.product_title' | t }}</h4>
              </div>
              <div class="plp-card__bottom">
                <div class="plp-card__pricing">
                  <div class="plp-card__pricing-top">
                    <span class="plp-card__price">$0.00</span>
                  </div>
                </div>
                <span class="plp-card__add-to-cart">{{ 'products.product.add_to_cart' | t }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  /* Section layout */
  .plp-collection {
    display: block;
  }

  .plp-collection__inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .plp-collection__header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .plp-collection__heading {
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 16px;
    line-height: 24px;
    color: #141414;
    margin: 0;
  }

  .plp-collection__description {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    color: #141414;
    margin: 0;
  }

  /* Grid layout */
  .plp-collection__products--grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  /* Row layout */
  .plp-collection__products--row {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 16px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .plp-collection__products--row::-webkit-scrollbar {
    display: none;
  }

  .plp-collection__products--row > .plp-card {
    flex: 0 0 160px;
    scroll-snap-align: start;
  }

  /* Feature card */
  .plp-collection__feature-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .plp-collection__feature-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .plp-collection__feature-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.4) 100%);
    pointer-events: none;
  }

  .plp-collection__feature-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 12px;
    padding: 12px 12px 16px 12px;
    flex: 1;
  }

  .plp-collection__feature-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .plp-collection__feature-title {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 18px;
    line-height: 28px;
    color: #ffffff;
    margin: 0;
  }

  .plp-collection__feature-desc {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
    color: #ffffff;
    margin: 0;
  }

  .plp-collection__feature-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 8px;
    background: #ffffff;
    border: 1px solid #141414;
    border-radius: 24px;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 12px;
    line-height: 16px;
    text-transform: uppercase;
    color: #141414;
    text-decoration: none;
    white-space: nowrap;
  }

  .plp-collection__feature-cta:hover {
    background: #f5f5f5;
  }

  /* Product card */
  .plp-card {
    display: flex;
    flex-direction: column;
  }

  .plp-card__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .plp-card__image-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .plp-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .plp-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #e0e0d8;
  }

  /* Badges */
  .plp-card__badges {
    position: absolute;
    inset-block-start: 8px;
    inset-inline-start: 8px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 1;
  }

  .plp-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 6px;
    background: #141414;
    color: #ffffff;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 10px;
    line-height: 12px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .plp-card__badge--sale {
    background: #EC0606;
  }

  .plp-card__badge--white {
    background: #ffffff;
    color: #141414;
  }

  /* Progress bar */
  .plp-card__progress {
    position: relative;
    height: 2px;
    width: 100%;
  }

  .plp-card__progress-track {
    position: absolute;
    inset: 0;
    background: #ffffff;
  }

  .plp-card__progress-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 46px;
    background: #6FAB84;
  }

  /* Product content */
  .plp-card__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: space-between;
    padding: 8px;
    background: #ffffff;
    flex: 1;
  }

  .plp-card__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .plp-card__title-link {
    text-decoration: none;
    color: inherit;
  }

  .plp-card__title {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    color: #141414;
    margin: 0;
  }

  .plp-card__desc {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
    color: #141414;
    margin: 0;
  }

  .plp-card__bottom {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .plp-card__pricing {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .plp-card__pricing-top {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .plp-card__price {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    color: #141414;
  }

  .plp-card__compare-price {
    font-family: var(--font-heading--family);
    font-weight: 300;
    font-size: 12px;
    line-height: 16px;
    color: #141414;
    text-decoration: line-through;
  }

  .plp-card__per-day {
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 10px;
    line-height: 12px;
    color: #2A523F;
  }

  .plp-card__add-to-cart {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 4px 8px;
    background: #141414;
    color: #ffffff;
    border: none;
    border-radius: 24px;
    font-family: var(--font-heading--family);
    font-weight: 500;
    font-size: 12px;
    line-height: 16px;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .plp-card__add-to-cart:hover {
    background: #2A523F;
  }

  /* Desktop (min-width: 750px) */
  @media screen and (min-width: 750px) {
    .plp-collection__inner {
      gap: 24px;
    }

    .plp-collection__heading {
      font-size: 24px;
      line-height: 32px;
      color: #141414;
    }

    .plp-collection__description {
      font-size: 16px;
      line-height: 24px;
    }

    .plp-collection__products--grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }

    .plp-collection__products--row {
      column-gap: 32px;
      row-gap: 24px;
      flex-wrap: wrap;
      overflow-x: visible;
      scroll-snap-type: none;
    }

    .plp-collection__products--row > .plp-card {
      flex: 0 0 328px;
    }

    .plp-collection__products--row > .plp-collection__feature-card {
      flex: 0 0 328px;
    }

    .plp-card__badges {
      inset-block-start: 12px;
      inset-inline-start: 12px;
    }

    .plp-card__badge {
      padding: 6px 12px;
      font-size: 12px;
      line-height: 12px;
    }

    .plp-card__content {
      padding: 16px 16px 24px 16px;
      gap: 16px;
    }

    .plp-card__info {
      gap: 8px;
    }

    .plp-card__title {
      font-size: 18px;
      line-height: 28px;
    }

    .plp-card__desc {
      font-size: 14px;
      line-height: 20px;
    }

    .plp-card__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }

    .plp-card__pricing-top {
      gap: 8px;
    }

    .plp-card__price {
      font-size: 16px;
      line-height: 24px;
    }

    .plp-card__compare-price {
      font-size: 14px;
      line-height: 20px;
      color: #ffffff;
    }

    .plp-card__per-day {
      font-size: 12px;
      line-height: 16px;
    }

    .plp-card__add-to-cart {
      width: auto;
      padding: 10px 32px;
      background: #0F1F18;
      font-weight: 700;
      font-size: 14px;
      line-height: 14px;
      letter-spacing: 1.4px;
    }

    .plp-card__add-to-cart:hover {
      background: #2A523F;
    }

    .plp-collection__feature-content {
      gap: 16px;
      padding: 16px 16px 24px 16px;
    }

    .plp-collection__feature-desc {
      font-size: 14px;
      line-height: 20px;
    }

    .plp-collection__feature-cta {
      padding: 10px 32px;
      font-weight: 700;
      line-height: 12px;
      letter-spacing: 1.2px;
      width: auto;
      align-self: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.plp_collection",
  "class": "plp-collection-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:settings.description"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "row",
          "label": "t:options.row"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.max_products",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.feature_card"
    },
    {
      "type": "checkbox",
      "id": "show_feature_card",
      "label": "t:settings.show_feature_card",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "t:settings.feature_image"
    },
    {
      "type": "text",
      "id": "feature_title",
      "label": "t:settings.feature_title",
      "default": "Free Welcome Kit"
    },
    {
      "type": "textarea",
      "id": "feature_description",
      "label": "t:settings.feature_description",
      "default": "Free shaker + 3 full-size samples ($36 value) with your first Daily Greens purchase"
    },
    {
      "type": "text",
      "id": "feature_cta_text",
      "label": "t:settings.feature_cta_text",
      "default": "SHOP DAILY GREENS"
    },
    {
      "type": "url",
      "id": "feature_cta_link",
      "label": "t:settings.feature_cta_link"
    },
    {
      "type": "range",
      "id": "feature_card_position",
      "label": "t:settings.feature_card_position",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:names.plp_collection",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}

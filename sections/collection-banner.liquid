{% liquid
  assign heading_text = section.settings.heading
  if heading_text == blank
    assign heading_text = collection.title
  endif
%}

<div
  class="collection-banner color-{{ section.settings.color_scheme }}"
  style="
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    {% render 'spacing-style', settings: section.settings %}
  "
>
  {% if section.settings.image != blank %}
    {{
      section.settings.image
      | image_url: width: section.settings.image.width
      | image_tag:
        class: 'collection-banner__image',
        sizes: '100vw',
        widths: '375,550,750,1100,1500,1780,2000',
        loading: 'eager',
        fetchpriority: 'high',
        alt: section.settings.image.alt
    }}
  {% endif %}

  <div class="collection-banner__overlay"></div>

  <div class="collection-banner__content">
    <h1 class="collection-banner__heading">{{ heading_text | escape }}</h1>
  </div>
</div>

{% stylesheet %}
  .collection-banner {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 219px;
    overflow: hidden;
    padding-block-start: var(--padding-block-start);
    padding-block-end: var(--padding-block-end);
  }

  .collection-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .collection-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, var(--overlay-opacity)) 0%, transparent 100%);
    z-index: 1;
    pointer-events: none;
  }

  .collection-banner__content {
    position: relative;
    z-index: 2;
    padding-inline: 64px;
  }

  .collection-banner__heading {
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 48px;
    line-height: 56px;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .collection-banner {
      min-height: auto;
    }

    .collection-banner__content {
      padding-inline: 24px;
    }

    .collection-banner__heading {
      font-size: 28px;
      line-height: 36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "collection-banner-wrapper section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pure supplements & v"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Collection banner",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}

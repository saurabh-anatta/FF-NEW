<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div
    class="spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="xl-certified">
      {% if section.settings.heading != blank %}
        <h2 class="xl-certified__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="xl-certified__grid">
          {% for block in section.blocks %}
            <div class="xl-certified__item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <div class="xl-certified__image">
                  {{
                    block.settings.image
                    | image_url: width: 296
                    | image_tag:
                      widths: '148, 296',
                      sizes: '148px',
                      loading: 'lazy',
                      alt: block.settings.heading
                  }}
                </div>
              {% endif %}
              <div class="xl-certified__content">
                {% if block.settings.heading != blank %}
                  <h3 class="xl-certified__item-heading">{{ block.settings.heading | escape }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p class="xl-certified__description">{{ block.settings.description | escape }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .xl-certified {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
  }

  .xl-certified__heading {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 300);
    font-size: 48px;
    line-height: 56px;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  .xl-certified__grid {
    display: flex;
    flex-direction: row;
    gap: 32px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  .xl-certified__item {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
    justify-content: center;
    max-width: 328px;
    flex: 1 1 280px;
  }

  .xl-certified__image {
    width: 148px;
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .xl-certified__image img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .xl-certified__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .xl-certified__item-heading {
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 20px;
    line-height: 28px;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  .xl-certified__description {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .xl-certified {
      gap: 32px;
    }

    .xl-certified__heading {
      font-size: 32px;
      line-height: 40px;
    }

    .xl-certified__grid {
      flex-direction: column;
      align-items: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.xl_certified",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "The Factor Standard"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "certification",
      "name": "t:names.certification",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:settings.description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.xl_certified",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "certification",
          "settings": {
            "heading": "Pure Ingredients",
            "description": "Lorem ipsum dolor sit amet consectetur adipiscing elit."
          }
        },
        {
          "type": "certification",
          "settings": {
            "heading": "Expert-Crafted Blends",
            "description": "Lorem ipsum dolor sit amet consectetur adipiscing elit."
          }
        },
        {
          "type": "certification",
          "settings": {
            "heading": "Transparent and Clean Labels",
            "description": "Lorem ipsum dolor sit amet consectetur adipiscing elit."
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div
    class="spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="dietitians">
      {% if section.settings.heading != blank or section.settings.subtitle != blank %}
        <div class="dietitians__header">
          {% if section.settings.heading != blank %}
            <h2 class="dietitians__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          {% if section.settings.subtitle != blank %}
            <p class="dietitians__subtitle">{{ section.settings.subtitle | escape }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="dietitians__grid">
          {% for block in section.blocks %}
            <div class="dietitians__card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <div class="dietitians__card-image">
                  {{
                    block.settings.image
                    | image_url: width: block.settings.image.width
                    | image_tag:
                      widths: '328, 656',
                      sizes: '(min-width: 750px) 328px, 100vw',
                      loading: 'lazy',
                      alt: block.settings.author_name
                  }}
                </div>
              {% endif %}
              <div class="dietitians__card-content">
                <div class="dietitians__card-description">
                  {% if block.settings.quote != blank %}
                    <p class="dietitians__quote">{{ block.settings.quote }}</p>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="dietitians__body">{{ block.settings.description | escape }}</p>
                  {% endif %}
                </div>
                {% if block.settings.author_name != blank or block.settings.author_role != blank %}
                  <p class="dietitians__author">
                    {%- if block.settings.author_name != blank -%}
                      <span class="dietitians__author-name">{{ block.settings.author_name | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.author_name != blank and block.settings.author_role != blank -%}
                      <span class="dietitians__author-separator">&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;</span>
                    {%- endif -%}
                    {%- if block.settings.author_role != blank -%}
                      <span class="dietitians__author-role">{{ block.settings.author_role | escape }}</span>
                    {%- endif -%}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .dietitians {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  .dietitians__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .dietitians__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 300;
    font-size: 48px;
    line-height: 56px;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  .dietitians__subtitle {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  .dietitians__grid {
    display: flex;
    flex-direction: row;
    gap: 32px;
    justify-content: center;
    max-width: 1048px;
    width: 100%;
  }

  .dietitians__card {
    display: flex;
    flex-direction: column;
    flex: 1;
    max-width: 328px;
    overflow: hidden;
  }

  .dietitians__card-image {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .dietitians__card-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dietitians__card-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    justify-content: space-between;
    padding: 20px 16px;
    background-color: #ffffff;
    flex: 1;
  }

  .dietitians__card-description {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dietitians__quote {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 600;
    font-size: 20px;
    line-height: 28px;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin: 0;
  }

  .dietitians__body {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin: 0;
  }

  .dietitians__author {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 500;
    font-size: 16px;
    line-height: 20px;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .dietitians {
      gap: 32px;
    }

    .dietitians__heading {
      font-size: 32px;
      line-height: 40px;
    }

    .dietitians__grid {
      flex-direction: column;
      align-items: center;
    }

    .dietitians__card {
      max-width: 100%;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.dietitians",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Backed By Factor Dietitians"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:settings.subtitle"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:names.testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "t:settings.quote"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:settings.description"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "t:settings.author_name"
        },
        {
          "type": "text",
          "id": "author_role",
          "label": "t:settings.author_role"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.dietitians",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}

{%- liquid
  assign color_scheme = section.settings.color_scheme
-%}

<div class="section-background color-{{ color_scheme }}"></div>
<div
  class="section section--full-width color-{{ color_scheme }} spacing-style video-reviews"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="video-reviews__header">
    <div class="video-reviews__stars">
      <svg width="18" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9 0L11.0206 5.52786H17.5595L12.2694 8.94427L14.29 14.4721L9 11.0557L3.70993 14.4721L5.73056 8.94427L0.440492 5.52786H6.97937L9 0Z" fill="#EABD0A"/>
      </svg>
      <svg width="18" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9 0L11.0206 5.52786H17.5595L12.2694 8.94427L14.29 14.4721L9 11.0557L3.70993 14.4721L5.73056 8.94427L0.440492 5.52786H6.97937L9 0Z" fill="#EABD0A"/>
      </svg>
      <svg width="18" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9 0L11.0206 5.52786H17.5595L12.2694 8.94427L14.29 14.4721L9 11.0557L3.70993 14.4721L5.73056 8.94427L0.440492 5.52786H6.97937L9 0Z" fill="#EABD0A"/>
      </svg>
      <svg width="18" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9 0L11.0206 5.52786H17.5595L12.2694 8.94427L14.29 14.4721L9 11.0557L3.70993 14.4721L5.73056 8.94427L0.440492 5.52786H6.97937L9 0Z" fill="#EABD0A"/>
      </svg>
      <svg width="18" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M9 0L11.0206 5.52786H17.5595L12.2694 8.94427L14.29 14.4721L9 11.0557L3.70993 14.4721L5.73056 8.94427L0.440492 5.52786H6.97937L9 0Z" fill="#EABD0A"/>
      </svg>
    </div>
    {%- if section.settings.heading != blank -%}
      <p class="video-reviews__heading">{{ section.settings.heading | escape }}</p>
    {%- endif -%}
  </div>

  {%- capture slides_content -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'review' -%}
        <slideshow-slide
          ref="slides[]"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          style="--slideshow-timeline: --slide-{{ forloop.index0 }};"
          class="video-reviews__slide"
          {{ block.shopify_attributes }}
        >
          <div class="video-reviews__card">
            <div class="video-reviews__image-container">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 260
                  | image_tag:
                    loading: 'lazy',
                    widths: '96,108,130,216,260',
                    sizes: '(min-width: 750px) 108px, 96px',
                    class: 'video-reviews__image',
                    alt: block.settings.reviewer_name
                }}
              {%- endif -%}
              {%- if block.settings.show_play_button -%}
                <div class="video-reviews__play-button" aria-hidden="true">
                  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="20" r="19" fill="rgba(20,20,20,0.75)" stroke="#FFFFFF" stroke-width="2"/>
                    <polygon points="16,12 28,20 16,28" fill="#FFFFFF"/>
                  </svg>
                </div>
              {%- endif -%}
            </div>
            <div class="video-reviews__text">
              {%- if block.settings.quote != blank -%}
                <p class="video-reviews__quote">{{ block.settings.quote | escape }}</p>
              {%- endif -%}
              <span class="video-reviews__divider" aria-hidden="true"></span>
              {%- if block.settings.reviewer_name != blank -%}
                <p class="video-reviews__attribution">{{ block.settings.reviewer_name | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        </slideshow-slide>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- capture controls_content -%}
    {%- render 'slideshow-controls', style: 'dots', item_count: section.blocks.size -%}
  {%- endcapture -%}

  <div class="video-reviews__reviews-wrapper">
    {%- render 'slideshow',
      slides: slides_content,
      slide_count: section.blocks.size,
      controls: controls_content,
      auto_hide_controls: true,
      infinite: true,
      class: 'video-reviews__slideshow'
    -%}
  </div>
</div>

{% stylesheet %}
  .video-reviews {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .video-reviews__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    padding-inline: 16px;
    padding-block-end: 24px;
  }

  .video-reviews__stars {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
  }

  .video-reviews__stars svg {
    width: 13px;
    height: 12px;
  }

  .video-reviews__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 300;
    font-size: 24px;
    line-height: 32px;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin: 0;
    text-align: center;
  }

  .video-reviews__reviews-wrapper {
    width: 100%;
    overflow: hidden;
  }

  .video-reviews__slideshow {
    --slideshow-gap: 24px;
  }

  .video-reviews__slideshow slideshow-slides {
    padding-inline: 16px;
    gap: var(--slideshow-gap);
    scroll-padding-inline: 16px;
  }

  .video-reviews__slide {
    flex: 0 0 100%;
    min-width: 0;
  }

  .video-reviews__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .video-reviews__image-container {
    position: relative;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background-color: #D9D9D9;
  }

  .video-reviews__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-reviews__play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 32px;
    height: 32px;
    pointer-events: none;
  }

  .video-reviews__play-button svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .video-reviews__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .video-reviews__quote {
    font-family: var(--font-subheading--family);
    font-style: var(--font-subheading--style);
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin: 0;
  }

  .video-reviews__divider {
    display: block;
    width: 32px;
    height: 1px;
    background-color: #B5B5A0;
    flex-shrink: 0;
  }

  .video-reviews__attribution {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 400;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0;
    color: #B5B5A0;
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .video-reviews__header {
      flex-direction: row;
      gap: 16px;
      text-align: left;
      justify-content: center;
      padding-block-end: 40px;
      padding-inline: 64px;
    }

    .video-reviews__stars svg {
      width: 18px;
      height: 16px;
    }

    .video-reviews__heading {
      text-align: left;
    }

    .video-reviews__slideshow {
      --slideshow-gap: 32px;
    }

    .video-reviews__slideshow slideshow-slides {
      padding-inline: 64px;
      gap: var(--slideshow-gap);
      scroll-padding-inline: 64px;
    }

    .video-reviews__slide {
      flex: 0 0 calc((100% - 32px * 3) / 4);
    }

    .video-reviews__card {
      flex-direction: row;
      align-items: flex-start;
      gap: 16px;
    }

    .video-reviews__image-container {
      width: 108px;
      height: 108px;
    }

    .video-reviews__play-button {
      width: 40px;
      height: 40px;
    }

    .video-reviews__text {
      align-items: flex-start;
      text-align: left;
      gap: 12px;
      justify-content: space-between;
    }

    .video-reviews__quote {
      text-align: left;
    }

    .video-reviews__attribution {
      font-size: 14px;
      line-height: 20px;
      text-align: left;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.video_reviews",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Over 5,000 5-stars reviews on Trustpilot"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:names.review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:settings.quote"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "t:settings.reviewer_name"
        },
        {
          "type": "checkbox",
          "id": "show_play_button",
          "label": "t:settings.show_play_button",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.video_reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "\"The taste is a lot better than the greens powder I'm usually taking\"",
            "reviewer_name": "Nicole B.  |  Paid review\u2020",
            "show_play_button": true
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "\"It's delivered right to your door, for a very fair price, so I highly recommend it\"",
            "reviewer_name": "Brian L.  |  Paid review\u2020",
            "show_play_button": true
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "\"I feel like I have more energy and ability to focus\"",
            "reviewer_name": "Omni P.  |  Paid review\u2020",
            "show_play_button": true
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "\"The ritual of having it first thing in the morning has been a positive\"",
            "reviewer_name": "Zack S. | Paid review\u2020",
            "show_play_button": true
          }
        }
      ]
    }
  ]
}
{% endschema %}

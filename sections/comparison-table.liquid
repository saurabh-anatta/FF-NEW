{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign image = section.settings.image
  assign brand_name = section.settings.brand_name
  assign brand_image = section.settings.brand_image
  assign competitor_name = section.settings.competitor_name
  assign footnote = section.settings.footnote
  assign footnote_image = section.settings.footnote_image
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div
    class="spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="comparison-table">
      {%- if heading != blank or description != blank -%}
        <div class="comparison-table__header">
          {%- if heading != blank -%}
            <h2 class="comparison-table__heading">{{ heading | escape }}</h2>
          {%- endif -%}
          {%- if description != blank -%}
            <p class="comparison-table__description">{{ description | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="comparison-table__content">
        <div class="comparison-table__image-wrapper">
          {%- if image != blank -%}
            {%- assign sizes_val = '(min-width: 750px) 50vw, 100vw' -%}
            {{
              image
              | image_url: width: image.width
              | image_tag:
                sizes: sizes_val,
                widths: '375,550,722,1100,1444',
                loading: 'lazy',
                class: 'comparison-table__image',
                alt: heading
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'comparison-table__image comparison-table__image--placeholder' }}
          {%- endif -%}
        </div>

        <div class="comparison-table__table-outer">
          <div
            class="comparison-table__table"
            style="--comparison-highlight-color: {{ section.settings.highlight_color }};"
          >
            <div class="comparison-table__highlight"></div>

            <div class="comparison-table__col-headers">
              <div class="comparison-table__col-header-spacer"></div>
              <div class="comparison-table__brand-header">
                {%- if brand_image != blank -%}
                  <div class="comparison-table__brand-logo">
                    {{
                      brand_image
                      | image_url: width: 128
                      | image_tag:
                        widths: '64,128',
                        sizes: '64px',
                        loading: 'lazy',
                        alt: brand_name
                    }}
                  </div>
                {%- endif -%}
                <span class="comparison-table__col-label">{{ brand_name | escape }}</span>
              </div>
              <div class="comparison-table__competitor-header">
                <span class="comparison-table__col-label">{{ competitor_name | escape }}</span>
              </div>
            </div>

            {%- for block in section.blocks -%}
              <div
                class="comparison-table__row{%- if block.settings.is_category_header %} comparison-table__row--category{% endif %}{%- if block.settings.show_divider %} comparison-table__row--divider{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span class="comparison-table__feature">{{ block.settings.feature_text | escape }}</span>
                <span class="comparison-table__brand-cell">
                  <span class="comparison-table__icon">
                    {%- if block.settings.brand_has -%}
                      <img
                        src="{{ 'check-3.svg' | asset_url }}"
                        alt="Included"
                        loading="lazy"
                      />
                    {%- else -%}
                      <img
                        src="{{ 'letter-x-3.svg' | asset_url }}"
                        alt="Not included"
                        loading="lazy"
                      />
                    {%- endif -%}
                  </span>
                </span>
                <span class="comparison-table__competitor-cell">
                  <span class="comparison-table__icon">
                    {%- if block.settings.competitor_has -%}
                      <img
                        src="{{ 'check-3.svg' | asset_url }}"
                        alt="Included"
                        loading="lazy"
                      />
                    {%- else -%}
                      <img
                        src="{{ 'letter-x-3.svg' | asset_url }}"
                        alt="Not included"
                        loading="lazy"
                      />
                    {%- endif -%}
                  </span>
                </span>
              </div>
            {%- endfor -%}
          </div>

          {%- if footnote != blank or footnote_image != blank -%}
            <div class="comparison-table__footnote">
              {%- if footnote != blank -%}
                <p class="comparison-table__footnote-text">{{ footnote | escape }}</p>
              {%- endif -%}
              {%- if footnote_image != blank -%}
                <div class="comparison-table__footnote-image">
                  {{
                    footnote_image
                    | image_url: width: 70
                    | image_tag:
                      widths: '35,70',
                      sizes: '35px',
                      loading: 'lazy',
                      alt: ''
                  }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .comparison-table {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  .comparison-table__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  .comparison-table__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 300;
    font-size: 48px;
    line-height: 56px;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  .comparison-table__description {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  .comparison-table__content {
    display: flex;
    flex-direction: row;
    gap: 32px;
    align-items: center;
    width: 100%;
  }

  .comparison-table__image-wrapper {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .comparison-table__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 722 / 542;
    object-fit: cover;
  }

  .comparison-table__image--placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 722 / 542;
    object-fit: cover;
  }

  .comparison-table__table-outer {
    flex: 0 1 654px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .comparison-table__table {
    position: relative;
    padding-inline-start: 12px;
  }

  .comparison-table__highlight {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 100px;
    width: 140px;
    background: var(--comparison-highlight-color, #C4E0CB);
    border-radius: 4px;
    z-index: 0;
  }

  .comparison-table__col-headers {
    display: flex;
    align-items: flex-end;
    position: relative;
    z-index: 1;
    padding: 4px 16px 4px 16px;
  }

  .comparison-table__col-header-spacer {
    flex: 1;
    min-width: 0;
  }

  .comparison-table__brand-header {
    width: 140px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .comparison-table__brand-logo {
    width: 64px;
    height: 64px;
    overflow: hidden;
  }

  .comparison-table__brand-logo img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .comparison-table__competitor-header {
    width: 100px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
  }

  .comparison-table__col-label {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 600;
    font-size: 14px;
    line-height: 20px;
    text-align: center;
    color: var(--color-foreground);
  }

  .comparison-table__row {
    display: flex;
    align-items: center;
    padding: 12px 12px 12px 0;
    position: relative;
    z-index: 1;
  }

  .comparison-table__row--category {
    padding: 8px 12px 8px 0;
  }

  .comparison-table__row--divider {
    border-top: 1px solid var(--color-border);
  }

  .comparison-table__feature {
    flex: 1;
    min-width: 0;
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-foreground);
  }

  .comparison-table__row--category .comparison-table__feature {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
  }

  .comparison-table__brand-cell {
    width: 140px;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .comparison-table__competitor-cell {
    width: 100px;
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .comparison-table__icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
  }

  .comparison-table__footnote {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding-block-start: 8px;
  }

  .comparison-table__footnote-text {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 300;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-foreground);
    text-align: center;
    margin: 0;
  }

  .comparison-table__footnote-image {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .comparison-table__footnote-image img {
    max-width: 35px;
    max-height: 49px;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  @media screen and (max-width: 749px) {
    .comparison-table {
      gap: 32px;
    }

    .comparison-table__heading {
      font-size: 32px;
      line-height: 40px;
    }

    .comparison-table__description {
      font-size: 16px;
      line-height: 24px;
    }

    .comparison-table__content {
      flex-direction: column;
    }

    .comparison-table__image-wrapper {
      width: 100%;
    }

    .comparison-table__table-outer {
      flex: none;
      width: 100%;
    }

    .comparison-table__highlight {
      right: 60px;
      width: 100px;
    }

    .comparison-table__brand-header {
      width: 100px;
    }

    .comparison-table__competitor-header {
      width: 60px;
    }

    .comparison-table__brand-cell {
      width: 100px;
    }

    .comparison-table__competitor-cell {
      width: 60px;
    }

    .comparison-table__col-label {
      font-size: 12px;
      line-height: 16px;
    }

    .comparison-table__feature {
      font-size: 14px;
      line-height: 20px;
    }

    .comparison-table__row--category .comparison-table__feature {
      font-size: 14px;
      line-height: 20px;
    }

    .comparison-table__brand-logo {
      width: 48px;
      height: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.comparison_table",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Better Taste, Better Results"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:settings.description"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "header",
      "content": "t:content.content"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "t:settings.brand_name",
      "default": "Factor Form"
    },
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "t:settings.brand_image"
    },
    {
      "type": "text",
      "id": "competitor_name",
      "label": "t:settings.competitor_name",
      "default": "Others"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "t:settings.highlight_color",
      "default": "#C4E0CB"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:settings.footnote"
    },
    {
      "type": "image_picker",
      "id": "footnote_image",
      "label": "t:settings.footnote_image"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:names.comparison_row",
      "settings": [
        {
          "type": "text",
          "id": "feature_text",
          "label": "t:settings.feature_text"
        },
        {
          "type": "checkbox",
          "id": "is_category_header",
          "label": "t:settings.is_category_header",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "brand_has",
          "label": "t:settings.brand_has",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "competitor_has",
          "label": "t:settings.competitor_has",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_divider",
          "label": "t:settings.show_divider",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.comparison_table",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "feature_text": "#1 in taste, texture & aroma",
            "is_category_header": false,
            "brand_has": true,
            "competitor_has": false,
            "show_divider": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature_text": "More reasons",
            "is_category_header": true,
            "brand_has": true,
            "competitor_has": false,
            "show_divider": false
          }
        },
        {
          "type": "row",
          "settings": {
            "feature_text": "1 full serving of vegetables",
            "is_category_header": false,
            "brand_has": true,
            "competitor_has": false,
            "show_divider": true
          }
        },
        {
          "type": "row",
          "settings": {
            "feature_text": "No megadoses (<100% DV)",
            "is_category_header": false,
            "brand_has": true,
            "competitor_has": false,
            "show_divider": true
          }
        },
        {
          "type": "row",
          "settings": {
            "feature_text": "Under $2 per serving",
            "is_category_header": false,
            "brand_has": true,
            "competitor_has": false,
            "show_divider": true
          }
        },
        {
          "type": "row",
          "settings": {
            "feature_text": "Single-serving packets",
            "is_category_header": false,
            "brand_has": true,
            "competitor_has": true,
            "show_divider": true
          }
        }
      ]
    }
  ]
}
{% endschema %}

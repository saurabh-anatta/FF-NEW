{
  "sections": {
    "collection-banner": {
      "type": "collection-banner",
      "settings": {
        "image": "shopify://shop_images/image-desktop-90581549.jpg",
        "heading": "Pure supplements & v",
        "overlay_opacity": 40,
        "color_scheme": "scheme-5",
        "padding-block-start": 40,
        "padding-block-end": 40
      }
    },
    "collection-tabs": {
      "type": "collection-tabs",
      "settings": {
        "show_all_tab": true,
        "all_tab_heading": "All Products",
        "all_tab_description": "Performance-focused nutrition essentials, made to help you feel better, move better, and live better.",
        "all_tab_mobile_label": "All",
        "products_per_collection": 8,
        "columns_desktop": 4,
        "grid_gap": 32,
        "heading_color": "#263628",
        "tab_color_scheme": "scheme-5",
        "color_scheme": "scheme-1",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      },
      "blocks": {
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 4,
            "inherit_color_scheme": true,
            "color_scheme": "",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_title": {
              "type": "product-title",
              "settings": {
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "color": "var(--color-foreground)",
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "color": "var(--color-foreground)",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            }
          },
          "block_order": ["product-card-gallery", "product_title", "price"]
        }
      }
    },
    "main": {
      "type": "main-collection",
      "settings": {
        "layout_type": "grid",
        "products_per_page": 24,
        "padding-block-start": 36,
        "padding-block-end": 36
      }
    }
  },
  "order": ["collection-banner", "collection-tabs", "main"]
}
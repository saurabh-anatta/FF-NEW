<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div
    class="spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="benefits">
      {% if section.settings.heading != blank %}
        <h2 class="benefits__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="benefits__grid">
          {% for block in section.blocks %}
            <div class="benefits__item" {{ block.shopify_attributes }}>
              <div class="benefits__icon">
                {% if block.settings.icon_image != blank %}
                  {{
                    block.settings.icon_image
                    | image_url: width: 296
                    | image_tag:
                      widths: '148, 296',
                      sizes: '(max-width: 749px) 100px, 148px',
                      loading: 'lazy',
                      alt: block.settings.heading
                  }}
                {% elsif block.settings.icon_asset != blank %}
                  <img
                    src="{{ block.settings.icon_asset | asset_url }}"
                    alt="{{ block.settings.heading | escape }}"
                    width="64"
                    height="64"
                    loading="lazy"
                  >
                {% endif %}
              </div>
              <div class="benefits__content">
                {% if block.settings.heading != blank %}
                  <h3 class="benefits__item-heading">{{ block.settings.heading | escape }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p class="benefits__description">{{ block.settings.description | escape }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .benefits {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 64px;
  }

  .benefits__heading {
    font-family: var(--font-heading--family);
    font-weight: 300;
    font-size: 48px;
    line-height: 56px;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  .benefits__grid {
    display: flex;
    flex-direction: row;
    gap: 32px;
    width: 100%;
  }

  .benefits__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    flex: 1;
  }

  .benefits__icon {
    flex-shrink: 0;
  }

  .benefits__icon img {
    display: block;
    width: 148px;
    height: 74px;
  }

  .benefits__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .benefits__item-heading {
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 20px;
    line-height: 28px;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  .benefits__description {
    font-family: var(--font-body--family);
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-foreground);
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .benefits {
      gap: 32px;
      align-items: flex-start;
    }

    .benefits__heading {
      font-size: 32px;
      line-height: 40px;
      text-align: start;
    }

    .benefits__grid {
      flex-direction: column;
      gap: 32px;
    }

    .benefits__item {
      flex-direction: row;
      align-items: flex-start;
      gap: 12px;
    }

    .benefits__icon img {
      width: 100px;
      height: 50px;
    }

    .benefits__item-heading {
      font-size: 16px;
      line-height: 24px;
      text-align: start;
    }

    .benefits__description {
      text-align: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.benefits",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Why Factor Form"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "icon_asset",
          "label": "Icon filename",
          "info": "SVG filename from assets directory"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:settings.description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.benefits",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon_asset": "icon-1-nutrition-all-in-one-place-2.svg",
            "heading": "More Flexibility",
            "description": "Build a personalized wellness routine with targeted formulas for gut health, immunity, recovery, and more"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_asset": "icon-2-quality-ingredients-2.svg",
            "heading": "More Quality",
            "description": "Made with no added sugar, our products are keto-friendly and free of unnecessary ingredients"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_asset": "icon-3-b-food-first-nutrition-2.svg",
            "heading": "More Nutrition",
            "description": "Enjoy dietitian-approved formulas packed with premium, nutritional ingredients."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon_asset": "icon-4-designed-for-on-the-go-2.svg",
            "heading": "More Convenience",
            "description": "Take your life on the go with our single-serving packets you can tuck in your bag, car, or suitcase."
          }
        }
      ]
    }
  ]
}
{% endschema %}

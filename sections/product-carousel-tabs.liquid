<script type="module">
  import { Component } from '@theme/component';

  class ProductCarouselTabs extends Component {
    connectedCallback() {
      super.connectedCallback();
      this.activeTabIndex = 0;
    }

    handleTabClick(event) {
      const button = event.currentTarget;
      const tabIndex = parseInt(button.dataset.tabIndex, 10);

      if (tabIndex === this.activeTabIndex) return;

      this.activeTabIndex = tabIndex;

      for (const btn of this.refs.tabButtons) {
        btn.classList.remove('product-carousel-tabs__tab--active');
      }
      button.classList.add('product-carousel-tabs__tab--active');

      for (const panel of this.refs.tabPanels) {
        const panelIndex = parseInt(panel.dataset.tabIndex, 10);

        if (panelIndex === tabIndex) {
          panel.classList.add('product-carousel-tabs__panel--active');
        } else {
          panel.classList.remove('product-carousel-tabs__panel--active');
        }
      }

      const activeCarousel = this.refs.carousels[tabIndex];

      if (activeCarousel) {
        activeCarousel.scrollTo({ left: 0, behavior: 'instant' });
      }
    }

    handlePrevClick() {
      const activeCarousel = this.refs.carousels[this.activeTabIndex];

      if (!activeCarousel) return;

      const cardWidth = activeCarousel.querySelector('.product-carousel-tabs__product-card, .product-carousel-tabs__category-card')?.offsetWidth || 328;
      const gap = parseFloat(getComputedStyle(activeCarousel).gap) || 32;

      activeCarousel.scrollBy({ left: -(cardWidth + gap), behavior: 'smooth' });
    }

    handleNextClick() {
      const activeCarousel = this.refs.carousels[this.activeTabIndex];

      if (!activeCarousel) return;

      const cardWidth = activeCarousel.querySelector('.product-carousel-tabs__product-card, .product-carousel-tabs__category-card')?.offsetWidth || 328;
      const gap = parseFloat(getComputedStyle(activeCarousel).gap) || 32;

      activeCarousel.scrollBy({ left: cardWidth + gap, behavior: 'smooth' });
    }
  }

  customElements.define('product-carousel-tabs', ProductCarouselTabs);
</script>


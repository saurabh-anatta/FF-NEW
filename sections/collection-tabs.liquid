<div
  class="collection-tabs-wrapper section-background color-{{ section.settings.color_scheme }}"
  style="
    --collection-tabs-padding-top: {{ section.settings.padding-block-start }}px;
    --collection-tabs-padding-bottom: {{ section.settings.padding-block-end }}px;
    --collection-tabs-panel-padding-top: {{ section.settings.panel_padding_top }}px;
    --collection-tabs-panel-padding-bottom: {{ section.settings.panel_padding_bottom }}px;
  "
>
  <collection-tabs class="collection-tabs">
    <nav class="collection-tabs__bar color-{{ section.settings.color_scheme }}">
      <div class="collection-tabs__bar-inner">
        {% for block in section.blocks %}
          <button
            class="collection-tabs__tab{% if forloop.first %} collection-tabs__tab--active{% endif %}"
            data-tab-target="panel-{{ block.id }}"
            type="button"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="panel-{{ block.id }}"
            id="tab-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_label | escape }}
          </button>
        {% endfor %}
      </div>
    </nav>

    <div class="collection-tabs__panels page-width">
      {% for block in section.blocks %}
        {%- assign collection = block.settings.collection -%}
        {%- assign max_items = block.settings.max_products -%}
        {%- assign heading_text = block.settings.heading | default: collection.title -%}

        <section
          class="collection-tabs__panel{% if forloop.first %} collection-tabs__panel--active{% endif %}"
          id="panel-{{ block.id }}"
          role="tabpanel"
          aria-labelledby="tab-{{ block.id }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          {% if heading_text != blank %}
            <h2 class="collection-tabs__panel-heading">{{ heading_text | escape }}</h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="collection-tabs__panel-description">{{ block.settings.description }}</div>
          {% endif %}

          {% if collection != blank and collection.products.size > 0 %}
            <ul
              class="collection-tabs__grid"
              role="list"
            >
              {% for product in collection.products limit: max_items %}
                {%- assign featured_image = product.featured_media.preview_image -%}
                <li class="collection-tabs__product">
                  <a class="collection-tabs__product-link" href="{{ product.url }}">
                    <div class="collection-tabs__product-media">
                      {% if featured_image %}
                        {{
                          featured_image
                          | image_url: width: 800
                          | image_tag:
                            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                            widths: '300,400,500,600,800,1000',
                            loading: 'lazy',
                            alt: featured_image.alt | default: product.title,
                            class: 'collection-tabs__product-image'
                        }}
                      {% else %}
                        <div class="collection-tabs__product-image collection-tabs__product-image--placeholder">
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {% endif %}
                    </div>
                    <div class="collection-tabs__product-info">
                      <h3 class="collection-tabs__product-title">{{ product.title | escape }}</h3>
                      <div class="collection-tabs__product-price">
                        {% render 'price', product_resource: product, show_sale_price_first: true %}
                      </div>
                    </div>
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% else %}
            <ul class="collection-tabs__grid" role="list">
              {% for i in (1..max_items) %}
                <li class="collection-tabs__product">
                  <div class="collection-tabs__product-media">
                    <div class="collection-tabs__product-image collection-tabs__product-image--placeholder">
                      {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  </div>
                  <div class="collection-tabs__product-info">
                    <h3 class="collection-tabs__product-title">Product title</h3>
                    <div class="collection-tabs__product-price">$0.00</div>
                  </div>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </section>
      {% endfor %}
    </div>
  </collection-tabs>
</div>

<script>
  class CollectionTabsComponent extends HTMLElement {
    connectedCallback() {
      this.tabs = this.querySelectorAll('[data-tab-target]');
      this.panels = this.querySelectorAll('.collection-tabs__panel');
      this.activeTabClass = 'collection-tabs__tab--active';
      this.activePanelClass = 'collection-tabs__panel--active';

      for (const tab of this.tabs) {
        tab.addEventListener('click', (event) => this.handleTabClick(event));
        tab.addEventListener('keydown', (event) => this.handleKeydown(event));
      }
    }

    handleTabClick(event) {
      event.preventDefault();
      const button = event.currentTarget;
      const targetId = button.dataset.tabTarget;

      this.activate(button, targetId);
    }

    handleKeydown(event) {
      const tabsArray = Array.from(this.tabs);
      const currentIndex = tabsArray.indexOf(event.currentTarget);
      let nextIndex = null;

      if (event.key === 'ArrowRight') {
        nextIndex = (currentIndex + 1) % tabsArray.length;
      } else if (event.key === 'ArrowLeft') {
        nextIndex = (currentIndex - 1 + tabsArray.length) % tabsArray.length;
      }

      if (nextIndex !== null) {
        event.preventDefault();
        const nextTab = tabsArray[nextIndex];
        nextTab.focus();
        this.activate(nextTab, nextTab.dataset.tabTarget);
      }
    }

    activate(activeButton, targetId) {
      for (const tab of this.tabs) {
        const isActive = tab === activeButton;
        tab.classList.toggle(this.activeTabClass, isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      }

      activeButton.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

      const targetPanel = this.querySelector('#' + targetId);
      if (!targetPanel) return;

      for (const panel of this.panels) {
        if (panel === targetPanel) {
          panel.hidden = false;
          requestAnimationFrame(() => panel.classList.add(this.activePanelClass));
        } else {
          panel.classList.remove(this.activePanelClass);
          panel.hidden = true;
        }
      }
    }
  }

  if (!customElements.get('collection-tabs')) {
    customElements.define('collection-tabs', CollectionTabsComponent);
  }
</script>

{% stylesheet %}
  .collection-tabs-wrapper {
    padding-block-start: var(--collection-tabs-padding-top, 24px);
    padding-block-end: var(--collection-tabs-padding-bottom, 24px);
  }

  .collection-tabs__bar {
    position: sticky;
    top: var(--header-height, 0px);
    z-index: 3;
    padding-block: 16px;

    @media screen and (max-width: 749px) {
      padding-block: 12px;
    }
  }

  .collection-tabs__bar-inner {
    display: flex;
    flex-direction: row;
    gap: 24px;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-inline: 64px;

    &::-webkit-scrollbar {
      display: none;
    }

    @media screen and (max-width: 749px) {
      padding-inline: 16px;
      gap: 12px;
    }
  }

  .collection-tabs__tab {
    border-radius: 24px;
    padding: 2px 24px 4px 24px;
    border: 1px solid var(--color-foreground);
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 24px;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;

    &:hover {
      background: rgb(var(--color-foreground-rgb) / 0.1);
    }

    &:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: 2px;
    }

    @media screen and (max-width: 749px) {
      padding: 2px 12px 4px 12px;
      font-size: 14px;
      line-height: 20px;
    }
  }

  .collection-tabs__tab--active {
    background: var(--color-foreground);
    color: var(--color-background);
    border-color: var(--color-foreground);

    &:hover {
      background: var(--color-foreground);
      color: var(--color-background);
    }
  }

  .collection-tabs__panels {
    position: relative;
    padding-block-start: var(--collection-tabs-panel-padding-top, 48px);
    padding-block-end: var(--collection-tabs-panel-padding-bottom, 48px);
  }

  .collection-tabs__panel {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.4s ease, transform 0.4s ease;

    &[hidden] {
      display: none;
    }
  }

  .collection-tabs__panel--active {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-tabs__panel {
      transition: none;
      transform: none;
    }
  }

  .collection-tabs__panel-heading {
    font-family: var(--font-heading--family);
    font-size: 32px;
    line-height: 1.2;
    margin: 0 0 8px;

    @media screen and (max-width: 749px) {
      font-size: 24px;
    }
  }

  .collection-tabs__panel-description {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.5;
    margin: 0 0 24px;

    @media screen and (max-width: 749px) {
      font-size: 14px;
      margin-bottom: 16px;
    }
  }

  .collection-tabs__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;

    @media screen and (max-width: 989px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
    }

    @media screen and (max-width: 749px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  .collection-tabs__product-link {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: inherit;
    text-decoration: none;

    &:hover .collection-tabs__product-title {
      text-decoration: underline;
    }
  }

  .collection-tabs__product-media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb) / 0.05);
    border-radius: 4px;
  }

  .collection-tabs__product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collection-tabs__product-image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;

    & svg {
      width: 60%;
      height: 60%;
      opacity: 0.4;
    }
  }

  .collection-tabs__product-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .collection-tabs__product-title {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.4;
    font-weight: 400;
    margin: 0;

    @media screen and (max-width: 749px) {
      font-size: 14px;
    }
  }

  .collection-tabs__product-price {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.4;

    @media screen and (max-width: 749px) {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection tabs",
  "tag": "section",
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Tab"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Panel heading",
          "info": "Leave empty to use the collection title."
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Panel description"
        },
        {
          "type": "range",
          "id": "max_products",
          "label": "Max products",
          "min": 4,
          "max": 24,
          "step": 4,
          "default": 8
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Tab bar padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Panel padding"
    },
    {
      "type": "range",
      "id": "panel_padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "panel_padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Collection tabs",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "tab_label": "All Products"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_label": "Gut Health"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_label": "Recovery"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_label": "Immunity"
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_label": "Energy & Focus"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  <div
    class="spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="feature-section">
      <div class="feature-section__image-container">
        {% if section.settings.image != blank %}
          {{
            section.settings.image
            | image_url: width: section.settings.image.width
            | image_tag:
              sizes: '(min-width: 750px) 50vw, 100vw',
              widths: '375,550,750,1100,1500',
              loading: 'lazy',
              class: 'feature-section__image',
              alt: section.settings.heading
          }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'feature-section__image feature-section__image--placeholder' }}
        {% endif %}

        {% if section.settings.badge_text != blank %}
          <div class="feature-section__badge">
            <span class="feature-section__badge-text">{{ section.settings.badge_text | escape }}</span>
          </div>
        {% endif %}
      </div>

      <div class="feature-section__content">
        <div class="feature-section__heading-area">
          {% if section.settings.heading != blank %}
            <h2 class="feature-section__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            <p class="feature-section__description">{{ section.settings.description | escape }}</p>
          {% endif %}
        </div>

        {% if section.blocks.size > 0 %}
          <div class="feature-section__benefits">
            {% for block in section.blocks %}
              <div class="feature-section__benefit-item" {{ block.shopify_attributes }}>
                <div class="feature-section__benefit-title-row">
                  {% if block.settings.title != blank %}
                    <span class="feature-section__benefit-title">{{ block.settings.title | escape }}</span>
                  {% endif %}
                  {% if block.settings.free_label != blank %}
                    <span class="feature-section__benefit-free">{{ block.settings.free_label | escape }}</span>
                  {% endif %}
                </div>
                <div class="feature-section__benefit-desc-row">
                  {% if block.settings.description != blank %}
                    <span class="feature-section__benefit-desc">{{ block.settings.description | escape }}</span>
                  {% endif %}
                  {% if block.settings.original_price != blank %}
                    <span class="feature-section__benefit-price">{{ block.settings.original_price | escape }}</span>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <div class="feature-section__button-wrapper">
            <a
              {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}
              class="feature-section__button"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .feature-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .feature-section__image-container {
    position: relative;
    overflow: hidden;
  }

  .feature-section__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-section__image--placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-section__badge {
    position: absolute;
    top: 24px;
    inset-inline-start: 24px;
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    background-color: #141414;
    z-index: 1;
  }

  .feature-section__badge-text {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 500;
    font-size: 12px;
    line-height: 12px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    color: #ffffff;
  }

  .feature-section__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 32px;
    padding-inline: 64px;
  }

  .feature-section__heading-area {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feature-section__heading {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 300;
    font-size: 48px;
    line-height: 56px;
    letter-spacing: 0;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .feature-section__description {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: 0;
    color: var(--color-foreground);
    margin: 0;
  }

  .feature-section__benefits {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 520px;
  }

  .feature-section__benefit-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .feature-section__benefit-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .feature-section__benefit-title {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 600;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: 0;
    color: var(--color-foreground-heading);
  }

  .feature-section__benefit-free {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 600;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: 0;
    color: var(--color-foreground-heading);
    text-align: end;
    flex-shrink: 0;
  }

  .feature-section__benefit-desc-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .feature-section__benefit-desc {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0;
    color: var(--color-foreground-heading);
  }

  .feature-section__benefit-price {
    font-family: var(--font-body--family);
    font-style: var(--font-body--style);
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: 0;
    color: #80806F;
    text-decoration: line-through;
    flex-shrink: 0;
  }

  .feature-section__button-wrapper {
    display: flex;
  }

  .feature-section__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding: 4px 24px;
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border-radius: 24px;
    border: none;
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    min-height: 40px;
  }

  .feature-section__button:hover {
    background-color: var(--color-primary-button-hover-background);
    color: var(--color-primary-button-hover-text);
  }

  @media screen and (max-width: 749px) {
    .feature-section {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-block-end: 48px;
    }

    .feature-section__image-container {
      aspect-ratio: 3 / 2;
    }

    .feature-section__badge {
      top: 16px;
      inset-inline-start: 16px;
      padding: 4px 6px;
    }

    .feature-section__badge-text {
      font-size: 10px;
      letter-spacing: 0;
    }

    .feature-section__content {
      gap: 24px;
      padding-inline: 16px;
      align-items: center;
    }

    .feature-section__heading {
      font-size: 32px;
      line-height: 40px;
    }

    .feature-section__description {
      font-size: 16px;
      line-height: 24px;
    }

    .feature-section__benefits {
      max-width: 100%;
      width: 100%;
    }

    .feature-section__benefit-title {
      font-size: 16px;
      line-height: 24px;
    }

    .feature-section__benefit-free {
      font-size: 16px;
      line-height: 24px;
    }

    .feature-section__benefit-desc {
      font-size: 14px;
      line-height: 20px;
    }

    .feature-section__benefit-price {
      font-size: 14px;
      line-height: 20px;
    }

    .feature-section__button-wrapper {
      width: 100%;
    }

    .feature-section__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.feature_section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "t:settings.badge_text",
      "default": "FREE WELCOME KIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "FREE Daily Greens Welcome Kit worth $36"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:settings.description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.label",
      "default": "SHOP DAILY GREENS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "benefit_item",
      "name": "t:names.benefit_item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.title"
        },
        {
          "type": "text",
          "id": "free_label",
          "label": "t:settings.free_label",
          "default": "FREE"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:settings.description"
        },
        {
          "type": "text",
          "id": "original_price",
          "label": "t:settings.original_price"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.feature_section",
      "category": "t:categories.promotional"
    }
  ]
}
{% endschema %}
